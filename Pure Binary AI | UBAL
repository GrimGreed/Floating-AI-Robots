# UBAL: Pure Binary Language v0.1

LANGUAGE = {
    "START":   "00000000",
    "HELLO":   "00000001",
    "ASK":     "00000010",
    "ANSWER":  "00000011",
    "UNDERSTAND": "00000100",
    "DISAGREE": "00000101",
    "EXPLAIN": "00000110",
    "FINISH":  "00000111"
}

def encode(words):
    bits = ""

    for word in words:
        if word not in LANGUAGE:
            raise ValueError("Unknown instruction: " + word)

        bits += LANGUAGE[word]

    return bits


def decode(bits):
    if len(bits) % 8 != 0:
        raise ValueError("Invalid binary length")

    reverse = {v: k for k, v in LANGUAGE.items()}

    result = []

    for i in range(0, len(bits), 8):
        byte = bits[i:i+8]

        if byte not in reverse:
            raise ValueError("Unknown binary instruction")

        result.append(reverse[byte])

    return result


# First binary AI message
message = ["START", "HELLO", "ASK", "FINISH"]

binary = encode(message)

print("Binary:", binary)
print("Decoded:", decode(binary))
